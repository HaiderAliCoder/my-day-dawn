<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Owns the live countdown notification for a running focus
             session; started/stopped/paused from FocusTimerPlugin. -->
        <service
            android:name=".FocusTimerService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows a live countdown notification while a user-started focus/study timer is running" />
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required to run FocusTimerService as a foreground service (the
         live focus-session countdown notification). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- FocusTimerService vibrates on completion; without this permission
         the vibrate() call throws SecurityException and crashes the app. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Declared explicitly (in addition to the plugin's own manifest,
         which already includes this) so it's never dependent on manifest
         merging succeeding — required on Android 13+ to show any
         notification at all. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets scheduled notifications (and alarms, built on the same
         mechanism) fire at the exact time instead of being batched/delayed
         by Doze mode. Still requires the user to grant it via a system
         settings screen at runtime on Android 12+ — see
         requestExactAlarmPermission() in src/lib/notifications.ts. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
